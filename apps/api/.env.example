APP_ENV=development
PORT=8000
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase Credentials (Keep backend-only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET_OR_JWKS_URL=your-supabase-jwt-secret
SUPABASE_STORAGE_BUCKET=student-documents

# Primary AI Provider: Groq
GROQ_API_KEY=your_groq_api_key
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# Fallback AI Provider: Google Gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_CHAT_MODEL=gemini-1.5-flash

# Dedicated Embedding Provider
EMBEDDING_PROVIDER=gemini
EMBEDDING_API_KEY=your_gemini_api_key
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=1536

# Resource Constraints & Policies
MAX_UPLOAD_MB=15
MAX_DOCUMENT_PAGES=300
MAX_CHUNKS_PER_DOCUMENT=3000
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
LOG_LEVEL=INFO
